# Source this before running any simulation: `source env/pdk.env`
export PDK_ROOT="${PDK_ROOT:-$HOME/pdk}"   # where volare installed the PDK
export PDK_VERSION=c6d73a35f524070e85faff4a6a9eef49553ebc2b
export PDK=sky130B
export PDKPATH=$PDK_ROOT/volare/sky130/versions/$PDK_VERSION/$PDK
export SPICE_MODELS=$PDKPATH/libs.tech/ngspice/sky130.lib.spice
echo "PDK env loaded: $PDKPATH"
